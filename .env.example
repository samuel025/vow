# Tatum gateway key (https://dashboard.tatum.io). Sui mainnet GraphQL is used for chain evidence.
TATUM_API_KEY=
# The Sui wallet address whose habits Vow verifies (read-only; no keys needed)
SUI_ADDRESS=0x

# Walrus Memory (https://docs.wal.app/walrus-memory): delegate key + MemWalAccount object id
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=0x
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=vow

# Optional
VOW_OWNER_NAME=            # how buddy messages refer to you (default "Your friend")
TELEGRAM_BOT_TOKEN=        # deliver buddy pings via Telegram; otherwise pings are previews
# TATUM_GRAPHQL_URL=https://sui-mainnet.gateway.tatum.io/graphql

# Optional AI (Ask-your-coach in plain language + "say your vow" drafting). Claude is used if set, else Gemini.
# The verifier and every kept/missed verdict stay rule-based; the model never decides a result.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# GEMINI_MODEL=gemini-2.5-flash

# Sessions and polling (optional)
# AUTH_SECRET=             # signs session cookies; auto-generated into data/ if unset (set it in production)
# VOW_CRON_SECRET=         # lets scripts/watch.ts check every wallet's vows
